# Copia este archivo como .env dentro de la carpeta del agente (p. ej. andes_hello/.env)

# --- Opción A: API de Gemini (sin Google Cloud) ---
GOOGLE_API_KEY=

# --- Opción B: Gemini Enterprise Agent Platform (Vertex) ---
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=andes-market-prod
# GOOGLE_CLOUD_LOCATION=us-central1

# --- andes_data ---
TOOLBOX_URL=http://127.0.0.1:5000
CARRIER_MCP_URL=http://127.0.0.1:8081/mcp
CARRIER_API_KEY=dev-key-andesexpress
# ERP on-prem (Docker local): ver andes_data/docker/compose.yaml
ERP_DB_HOST=127.0.0.1
ERP_DB_PORT=5433
ERP_DB_NAME=erp
ERP_DB_USER=erp
ERP_DB_PASSWORD=erp
# Pedidos (Cloud SQL en producción; en local, el segundo Postgres del compose)
ORDERS_DB_HOST=127.0.0.1
ORDERS_DB_PORT=5432
ORDERS_DB_NAME=orders
ORDERS_DB_USER=orders
ORDERS_DB_PASSWORD=orders
CLOUDSQL_INSTANCE=andes-orders
BQ_DATASET=andes_analytics

# --- andes_prod ---
# ID del Agent Runtime (reasoningEngines/<ID>) usado para Sessions y Memory Bank
AGENT_ENGINE_ID=
# Plantillas de Model Armor (dejar vacío para desactivar el plugin en local)
MODEL_ARMOR_PROMPT_TEMPLATE=
MODEL_ARMOR_RESPONSE_TEMPLATE=
# Agente A2A remoto de logística (opcional)
LOGISTICS_A2A_CARD=
